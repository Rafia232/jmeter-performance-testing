            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&#xd;
{&#xd;
  &quot;customerId&quot;: &quot;01a1a9e8-56d9-7175-beac-eae8e95de69c&quot;,&#xd;
  &quot;scheduleId&quot;: &quot;${scheduleId}&quot;,&#xd;
  &quot;seats&quot;: [&#xd;
    {&#xd;
      &quot;seatMapId&quot;: &quot;${seatMapId}&quot;,&#xd;
      &quot;passengerName&quot;: &quot;Patrick&quot;,&#xd;
      &quot;passengerSurname&quot;: &quot;Banda&quot;,&#xd;
      &quot;passengerPIN&quot;: &quot;4154566666&quot;,&#xd;
      &quot;cellphone&quot;: &quot;260416666666&quot;,&#xd;
      &quot;passengerPINTypeId&quot;: 3,&#xd;
      &quot;gender&quot;: 1&#xd;
    }&#xd;
  ],&#xd;
  &quot;seatStatus&quot;: 2,&#xd;
  &quot;purchaseChannel&quot;: 1,&#xd;
  &quot;operatorId&quot;: &quot;26000000-0000-4000-8000-000000000001&quot;,&#xd;
  &quot;boardingStation&quot;: &quot;26000000-0000-4000-8000-000000000101&quot;,&#xd;
  &quot;droppingStation&quot;: &quot;26000000-0000-4000-8000-000000000102&quot;&#xd;
}&#xd;
</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
