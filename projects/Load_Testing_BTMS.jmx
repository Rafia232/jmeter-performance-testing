          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="tickets/btms-api/booking">
            <stringProp name="HTTPSampler.domain">btms-sz-api.avolytic.com</stringProp>
